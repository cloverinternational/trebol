{
  "name": "@pi-swarm/voice",
  "version": "0.2.0",
  "private": true,
  "description": "Speech-to-text for Pi: local capture with remote (LAN/Tailscale) or local transcription",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "index.ts",
    "catalog/catalog.json",
    "catalog/recommendations.json",
    "models/silero-vad-v6.2-F32.gguf",
    "models/README.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "transcription",
    "speech-to-text"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node scripts/run-tests.mjs",
    "recommendations:generate": "node scripts/generate-recommendations.mjs",
    "catalog:verify": "node scripts/catalog-metadata.mjs",
    "catalog:update-metadata": "node scripts/catalog-metadata.mjs --write"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@huggingface/gguf": "^0.4.6",
    "@types/node": "22.20.1",
    "typebox": "^1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@handy-computer/recorder": "0.2.1",
    "@huggingface/hub": "2.15.0",
    "opencc-js": "^1.4.1",
    "transcribe-cpp": "0.4.0"
  }
}
