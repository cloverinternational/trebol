# Local API credentials (never commit real keys)
.pi/config/api-keys.json
.pi/config/*.local.json

# Runtime state (never a source of truth)
.pi/agent-sessions/
.swarm/

# Probe outputs, baselines, recordings
artifacts/
.tape/*-sessions/

# Build output and dependencies
**/dist/
# Generated e2e and probe artifacts (target/shots/tern/**): reproducible by the
# node tools/e2e/*.mjs scripts that write them, so never a source of truth.
target/

# Dependencies. The pattern deliberately has NO trailing slash: `node_modules/`
# matches directories only, which is how an absolute-path symlink named
# `node_modules` got tracked in 3746215 and broke every checkout. A bare
# `node_modules` matches the directory, a file, and a symlink at any depth.
# Never share dependencies by committing a link -- see
# `node tools/repo/link-node-modules.mjs` for a per-worktree RELATIVE link.
node_modules

# Pi project-scope package installs (pi install -l)
.pi/git/
.pi/npm/

# Temporary runtime diagnostics (not project memory)
.swarmpi/

__pycache__/
*.pyc
Untitled
.pi/render-debug*
.pi/latest-box.png
*.before-paseo-disabled

# Local CLI/editor state (machine-specific, never commit)
.local/
